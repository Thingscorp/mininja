{
  "version": "1.6.3",
  "name": "Mininja mark",
  "owner": "Thingscorp LLC",
  "mascotNamed": false,
  "forbiddenNames": [
    "Casque"
  ],
  "grid": {
    "columns": 5,
    "rows": 3,
    "cellAspect": "1:1",
    "totalCells": 15
  },
  "codepoints": {
    "hoodCornerRightFacing": "U+259A",
    "hoodCornerLeftFacing": "U+259E",
    "fullBlock": "U+2588",
    "upperHalfBlock": "U+2580",
    "space": "U+0020"
  },
  "canonicalIdle": {
    "lines": [
      "▚████",
      "██ ●●",
      "▀▀▀▀▀"
    ],
    "note": "Glyphs ARE the mark. Five columns × three rows."
  },
  "mirroredIdle": {
    "lines": [
      "████▞",
      "●● ██",
      "▀▀▀▀▀"
    ],
    "usedBy": [
      "loadingLeft",
      "facing-left"
    ]
  },
  "clearspace": {
    "rule": "one block-row height on all sides",
    "asFractionOfHeight": 0.3333333333333333
  },
  "minimumSize": {
    "digitalPxHeight": 24,
    "terminalRows": 3,
    "minCellPx": 8
  },
  "typeface": {
    "family": "IBM Plex Mono",
    "weights": [
      400,
      500,
      600
    ],
    "cssStack": "\"IBM Plex Mono\", ui-monospace, \"SF Mono\", Menlo, monospace",
    "rule": "Lockup must load IBM Plex Mono; do not rely on system monospace for production mark rendering. Uncontrolled surfaces (README/OG/email/print) use pre-rendered SVG/PNG from this face."
  },
  "monochrome": true,
  "moodColorsUiOnly": {
    "idle": "#334155",
    "accent": "#6366f1",
    "ok": "#22c55e",
    "warn": "#eab308",
    "err": "#ef4444"
  },
  "faces": {
    "idle": {
      "eyes": [
        "●",
        "●"
      ],
      "tone": "idle",
      "motion": null,
      "mirrored": false,
      "lines": [
        "▚████",
        "██ ●●",
        "▀▀▀▀▀"
      ]
    },
    "blink": {
      "eyes": [
        "─",
        "─"
      ],
      "tone": "idle",
      "motion": null,
      "mirrored": false,
      "lines": [
        "▚████",
        "██ ──",
        "▀▀▀▀▀"
      ]
    },
    "evaluating": {
      "eyes": [
        "◐",
        "◑"
      ],
      "tone": "accent",
      "motion": "pulse",
      "mirrored": false,
      "lines": [
        "▚████",
        "██ ◐◑",
        "▀▀▀▀▀"
      ]
    },
    "allowed": {
      "eyes": [
        ">",
        "<"
      ],
      "tone": "ok",
      "motion": "bounce",
      "mirrored": false,
      "lines": [
        "▚████",
        "██ ><",
        "▀▀▀▀▀"
      ]
    },
    "asking": {
      "eyes": [
        "?",
        "?"
      ],
      "tone": "warn",
      "motion": null,
      "mirrored": false,
      "lines": [
        "▚████",
        "██ ??",
        "▀▀▀▀▀"
      ]
    },
    "denied": {
      "eyes": [
        "┃",
        "┃"
      ],
      "tone": "err",
      "motion": "shake",
      "mirrored": false,
      "lines": [
        "▚████",
        "██ ┃┃",
        "▀▀▀▀▀"
      ]
    },
    "sandboxing": {
      "eyes": [
        "◇",
        "◇"
      ],
      "tone": "idle",
      "motion": null,
      "mirrored": false,
      "lines": [
        "▚████",
        "██ ◇◇",
        "▀▀▀▀▀"
      ]
    },
    "executing": {
      "eyes": [
        "◣",
        "◢"
      ],
      "tone": "accent",
      "motion": "pulse",
      "mirrored": false,
      "lines": [
        "▚████",
        "██ ◣◢",
        "▀▀▀▀▀"
      ]
    },
    "completed": {
      "eyes": [
        "▴",
        "▴"
      ],
      "tone": "ok",
      "motion": "bounce",
      "mirrored": false,
      "lines": [
        "▚████",
        "██ ▴▴",
        "▀▀▀▀▀"
      ]
    },
    "warning": {
      "eyes": [
        "▲",
        "△"
      ],
      "tone": "warn",
      "motion": "bounce",
      "mirrored": false,
      "lines": [
        "▚████",
        "██ ▲△",
        "▀▀▀▀▀"
      ]
    },
    "error": {
      "eyes": [
        "×",
        "×"
      ],
      "tone": "err",
      "motion": "shake",
      "mirrored": false,
      "lines": [
        "▚████",
        "██ ××",
        "▀▀▀▀▀"
      ]
    },
    "cancelled": {
      "eyes": [
        "◦",
        "◦"
      ],
      "tone": "idle",
      "motion": null,
      "mirrored": false,
      "lines": [
        "▚████",
        "██ ◦◦",
        "▀▀▀▀▀"
      ]
    },
    "offline": {
      "eyes": [
        "‒",
        "‒"
      ],
      "tone": "idle",
      "motion": null,
      "mirrored": false,
      "lines": [
        "▚████",
        "██ ‒‒",
        "▀▀▀▀▀"
      ]
    },
    "loadingRight": {
      "eyes": [
        "●",
        "●"
      ],
      "tone": "accent",
      "motion": "pulse",
      "mirrored": false,
      "lines": [
        "▚████",
        "██ ●●",
        "▀▀▀▀▀"
      ]
    },
    "loadingLeft": {
      "eyes": [
        "●",
        "●"
      ],
      "tone": "accent",
      "motion": "pulse",
      "mirrored": true,
      "lines": [
        "████▞",
        "●● ██",
        "▀▀▀▀▀"
      ]
    }
  },
  "presenceLadder": [
    {
      "level": 1,
      "id": "mark-only",
      "needs": [
        "canonicalIdle"
      ]
    },
    {
      "level": 2,
      "id": "face-states",
      "needs": [
        "faces"
      ]
    },
    {
      "level": 3,
      "id": "scoot-facing",
      "needs": [
        "faces",
        "mirroredIdle"
      ]
    },
    {
      "level": 4,
      "id": "scene-strip",
      "needs": [
        "kit/scene.json"
      ]
    }
  ]
}
